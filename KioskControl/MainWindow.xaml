<Window x:Class="KioskControl.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KioskControl | ניהול קיוסק" Height="720" Width="1120" MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="{StaticResource Page}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#172554" CornerRadius="16" Padding="22" Margin="0,0,0,18">
   <StackPanel><TextBlock Text="KioskControl" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBlock Text="ניהול תוכנות מורשות למחשב מקומי" Foreground="#BFDBFE" FontSize="14" Margin="0,5,0,0"/></StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="18" Margin="0,0,16,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
      <Button Content="הוסף תוכנה" Click="AddApp_Click" Padding="16,9" Background="#2563EB" Foreground="White" BorderThickness="0"/>
      <Button Content="שמור הגדרות" Click="Save_Click" Padding="16,9" Margin="8,0,0,0"/>
     </StackPanel>
     <DataGrid x:Name="AppsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Columns><DataGridTextColumn Header="שם התוכנה" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="נתיב קובץ EXE" Binding="{Binding ExecutablePath}" Width="2*"/><DataGridCheckBoxColumn Header="מאושר" Binding="{Binding Enabled}" Width="75"/></DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
   <StackPanel Grid.Column="1">
    <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,0,14">
     <StackPanel><TextBlock Text="הפעלה מהירה" FontSize="19" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock Text="בחר תוכנה ברשימה ולחץ הפעלה." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/><Button Content="הפעל תוכנה נבחרת" Click="Launch_Click" Padding="12"/></StackPanel>
    </Border>
    <Border Background="White" CornerRadius="14" Padding="18">
     <StackPanel><TextBlock Text="מצב המערכת" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="שלב 1 – ממשק ניהול ורשימת תוכנות" Foreground="#334155" TextWrapping="Wrap"/><TextBlock Text="אכיפת חסימה מערכתית תתווסף לאחר בדיקת תאימות למדיניות Windows." Foreground="#B45309" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
    </Border>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
